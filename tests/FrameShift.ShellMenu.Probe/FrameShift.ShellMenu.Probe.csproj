<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FixtureExports.cs" />
    <Compile Include="../../src/FrameShift/Core/Localization/AppLanguages.cs" Link="AppLanguages.cs" />
    <Compile Include="../../src/FrameShift.ShellMenu/ComAbi.cs" Link="ComAbi.cs" />
    <Compile Include="../../src/FrameShift.ShellMenu/NativeMenu.cs" Link="NativeMenu.cs" />
  </ItemGroup>
</Project>
