    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FrameShift/FrameShift.csproj" />
  </ItemGroup>
</Project>
