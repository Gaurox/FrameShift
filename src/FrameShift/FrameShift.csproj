<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Shared DPI mode for development and the 1.20.0 release candidate; installed qualification is recorded in phase G. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Icons\app\app.ico</ApplicationIcon>
    <Version>1.21.1</Version>
    <AssemblyVersion>1.21.1.0</AssemblyVersion>
    <FileVersion>1.21.1.0</FileVersion>
    <InformationalVersion>1.21.1</InformationalVersion>
    <Product>FrameShift</Product>
    <Company>FrameShift</Company>
    <Description>Windows-first offline multimedia processing utility.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="PDFiumCore" Version="156.0.8076" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Clipper2" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\AI\Ocr\model-files.json" />
    <EmbeddedResource Include="Assets\Ocr\glyphless.ttf" />
    <Content Include="..\..\licenses\ocr\**\*" Link="licenses\ocr\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FrameShift.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FrameShift.UiSamples</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="Tools\ffmpeg\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\LICENSE" Link="licenses\LICENSE">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\FrameShift.SubtitlesWorker\native-dml\THIRD_PARTY_NOTICES.txt" Link="licenses\subtitles-worker-native\THIRD_PARTY_NOTICES.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\licenses\subtitles-worker-native\APACHE-2.0.txt" Link="licenses\subtitles-worker-native\APACHE-2.0.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\licenses\subtitles-worker-native\DirectML-LICENSE.txt" Link="licenses\subtitles-worker-native\DirectML-LICENSE.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\licenses\subtitles-worker-native\DirectML-THIRD_PARTY_NOTICES.txt" Link="licenses\subtitles-worker-native\DirectML-THIRD_PARTY_NOTICES.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyCreateSubtitlesWorkerForBuild" AfterTargets="Build">
    <PropertyGroup>
      <_CreateSubtitlesWorkerProject>$(MSBuildThisFileDirectory)..\FrameShift.SubtitlesWorker\FrameShift.SubtitlesWorker.csproj</_CreateSubtitlesWorkerProject>
      <_CreateSubtitlesWorkerBuildOutput>$(MSBuildThisFileDirectory)..\FrameShift.SubtitlesWorker\bin\$(Configuration)\net8.0-windows\win-x64\</_CreateSubtitlesWorkerBuildOutput>
      <_CreateSubtitlesWorkerBuildTarget>$(OutDir)Workers\CreateSubtitlesWorker\</_CreateSubtitlesWorkerBuildTarget>
    </PropertyGroup>

    <MSBuild
      Projects="$(_CreateSubtitlesWorkerProject)"
      Targets="Build"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64" />

    <MakeDir Directories="$(_CreateSubtitlesWorkerBuildTarget)" />

    <ItemGroup>
      <_CreateSubtitlesWorkerBuildFiles Include="$(_CreateSubtitlesWorkerBuildOutput)**\*" Condition="Exists('$(_CreateSubtitlesWorkerBuildOutput)')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_CreateSubtitlesWorkerBuildFiles)"
      DestinationFiles="@(_CreateSubtitlesWorkerBuildFiles->'$(_CreateSubtitlesWorkerBuildTarget)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(_CreateSubtitlesWorkerBuildFiles)' != ''" />
  </Target>

  <Target Name="PublishCreateSubtitlesWorker" AfterTargets="Publish">
    <PropertyGroup>
      <_CreateSubtitlesWorkerProject>$(MSBuildThisFileDirectory)..\FrameShift.SubtitlesWorker\FrameShift.SubtitlesWorker.csproj</_CreateSubtitlesWorkerProject>
      <_CreateSubtitlesWorkerPublishTarget>$([System.IO.Path]::GetFullPath('$(PublishDir)Workers\CreateSubtitlesWorker\'))</_CreateSubtitlesWorkerPublishTarget>
    </PropertyGroup>

    <MSBuild
      Projects="..\FrameShift.SubtitlesWorker\FrameShift.SubtitlesWorker.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(_CreateSubtitlesWorkerPublishTarget)" />
  </Target>

  <Target Name="RemovePublishDebugSymbols" AfterTargets="PublishCreateSubtitlesWorker">
    <ItemGroup>
      <_PublishDebugSymbols Include="$(PublishDir)**\*.pdb" />
      <_PublishDebugSymbols Include="$(PublishDir)**\*.dbg" />
    </ItemGroup>

    <Delete Files="@(_PublishDebugSymbols)" />
  </Target>
</Project>
